          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/list-certifications-by-suiteParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "list-compatibility-records"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/list-compatibility-recordsParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "list-release-records"
          }
        },
        "required": [

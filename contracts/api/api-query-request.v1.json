    {
      "if": {
        "properties": {
          "kind": {
            "const": "resolve-active-release"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/resolve-active-releaseParams"
          }
        }
      }

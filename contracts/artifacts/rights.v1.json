{
  "$id": "arena:schema/artifacts/rights@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit licensing and usage constraints. REQUIRED on provenance records and publication records — missing rights metadata is rejected (architecture-lock rule 23; requirements R47, R48).",
  "properties": {
    "commercialUse": {
      "enum": [
        "allowed",
        "requires-license",
        "prohibited"
      ]
    },
    "customerData": {
      "enum": [
        "none",
        "derived",
        "contains"
      ]
    },
    "license": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 .+()\\-]{0,63}$",
      "type": "string"
    },
    "professionalLimitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "redistribution": {
      "enum": [
        "allowed",
        "tenant-only",
        "prohibited"
      ]
    }
  },
  "required": [
    "license",
    "commercialUse",
    "redistribution",
    "customerData"
  ],
  "title": "Arena RightsMetadata v1",
  "type": "object"
}

{
  "$id": "arena:schema/task/task-spec@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The versioned, content-addressed reproducible unit of work (spec/task-spec.md TS1.0; docs/architecture.md §6). Carries every TS1.0 structure field plus long-horizon evidence (REQUIRED for the long-horizon-execution class), the seven declared quality dimensions and the derivation provenance. Cross-field rules (enforced by the guards): private-tenant data rights forbid cross-tenant reuse; the pinned initial-state environment must be among the required environment declarations; supersession targets the same logical task at strictly lower semver precedence.",
  "properties": {
    "capabilityLabels": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "completionCriteria": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "constraints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "dataRights": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "private-tenant",
            "tenant-shareable",
            "arena-internal",
            "public"
          ],
          "type": "string"
        },
        "crossTenantReuse": {
          "type": "boolean"
        },
        "licensing": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "privacyNotes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "tenantScope": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "type": "string"
        }
      },
      "required": [
        "classification",
        "tenantScope",
        "crossTenantReuse",
        "licensing",
        "privacyNotes"
      ],
      "type": "object"
    },
    "derivedFrom": {
      "additionalProperties": false,
      "properties": {
        "caseRef": {
          "additionalProperties": false,
          "properties": {
            "caseId": {
              "pattern": "^[a-z][a-z0-9-]{0,127}$",
              "type": "string"
            },
            "digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "tenant": {
              "pattern": "^[a-z][a-z0-9-]{1,62}$",
              "type": "string"
            },
            "version": {
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
              "type": "string"
            }
          },
          "required": [
            "tenant",
            "caseId",
            "version",
            "digest"
          ],
          "type": "object"
        },
        "policyRef": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "policyId": {
              "pattern": "^[a-z][a-z0-9-]{0,63}$",
              "type": "string"
            },
            "version": {
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
              "type": "string"
            }
          },
          "required": [
            "policyId",
            "version",
            "digest"
          ],
          "type": "object"
        }
      },
      "required": [
        "caseRef",
        "policyRef"
      ],
      "type": "object"
    },
    "difficulty": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "exploratory",
            "standard",
            "routine"
          ],
          "type": "string"
        },
        "scale": {
          "enum": [
            "arena:task-difficulty@1"
          ],
          "type": "string"
        }
      },
      "required": [
        "scale",
        "class"
      ],
      "type": "object"
    },
    "digest": {
      "description": "sha256 over the canonical serialization of the digest-free view.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "domain": {
      "allOf": [
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "id": {
              "pattern": "^[a-z][a-z0-9-]{0,127}$",
              "type": "string"
            },
            "kind": {
              "enum": [
                "domain",
                "capability",
                "sub-capability",
                "skill",
                "tool",
                "task-family",
                "evaluator",
                "verifier",
                "expert-competency",
                "observed-failure",
                "body-version"

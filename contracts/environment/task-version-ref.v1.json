{
  "$id": "arena:schema/environment/task-version-ref@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Minimal versioned task reference (id + version); the task-spec protocol owns the full task surface.",
  "properties": {
    "taskId": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "taskId",
    "version"
  ],
  "title": "Arena task version ref v1",
  "type": "object"
}

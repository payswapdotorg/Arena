{
  "$defs": {
    "checkpointRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to a checkpoint.",
      "properties": {
        "checkpointId": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "checkpointId",
        "digest"
      ],
      "type": "object"
    }
  },
  "$id": "arena:schema/environment/reset-semantics@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "How a run world is reset. Mode reset-to-checkpoint requires a valid checkpoint ref; the snapshot modes require the initial state snapshot support flag.",
  "properties": {
    "checkpoint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/checkpointRef"
        }
      ]
    },
    "cleanup": {
      "enum": [
        "destroy",
        "retain-evidence"
      ]
    },
    "mode": {
      "enum": [
        "recreate",
        "restore-snapshot",
        "reset-to-checkpoint"
      ]
    }
  },
  "required": [
    "mode",
    "checkpoint",
    "cleanup"
  ],
  "title": "Arena reset semantics v1",
  "type": "object"
}

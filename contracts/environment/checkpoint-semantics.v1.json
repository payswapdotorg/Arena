{
  "$id": "arena:schema/environment/checkpoint-semantics@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Whether checkpointing is supported, its closed trigger set and its bounded retention. Support requires the initial state snapshot support flag.",
  "properties": {
    "retention": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "description": "Strictly positive integer (a bound that does not bound is not a bound).",
          "minimum": 1,
          "type": "integer"
        }
      ]
    },
    "supported": {
      "type": "boolean"
    },
    "triggers": {
      "items": {
        "enum": [
          "manual",
          "scheduled",
          "on-phase"
        ]
      },
      "type": "array"
    }
  },
  "required": [
    "supported",
    "triggers",
    "retention"
  ],
  "title": "Arena checkpoint semantics v1",
  "type": "object"
}

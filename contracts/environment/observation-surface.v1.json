{
  "$id": "arena:schema/environment/observation-surface@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The closed set of observation channels the environment emits (at least one required).",
  "properties": {
    "observations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "enum": [
              "stdout",
              "stderr",
              "files",
              "events",
              "metrics",
              "state-dump"
            ]
          },
          "description": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^[\\x20-\\x7E\\n\\t]{1,512}$",
                "type": "string"
              }
            ]
          },
          "observationId": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "observationId",
          "channel",
          "description"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "observations"
  ],
  "title": "Arena observation surface v1",
  "type": "object"
}

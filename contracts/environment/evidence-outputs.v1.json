{
  "$id": "arena:schema/environment/evidence-outputs@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The closed set of evidence kinds a run produces, each with its digest addressing policy (spec ENV1.0 Evidence).",
  "properties": {
    "outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "addressing": {
            "enum": [
              "content-addressed",
              "append-only-ledger"
            ]
          },
          "description": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^[\\x20-\\x7E\\n\\t]{1,512}$",
                "type": "string"
              }
            ]
          },
          "kind": {
            "enum": [
              "trajectory",
              "artifacts",
              "logs",
              "metrics",
              "observations",
              "environment-state"
            ]
          },
          "outputId": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "outputId",
          "kind",
          "addressing",
          "description"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "outputs"
  ],
  "title": "Arena evidence outputs v1",
  "type": "object"
}

{
  "$defs": {
    "artifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9-]{1,127}$",
          "type": "string"
        },
        "namespace": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "version",
        "digest"
      ],
      "type": "object"
    }
  },
  "$id": "arena:schema/capability-case/task-requirements@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a case requires of the tasks compiled from it, in the TaskSpec §6 vocabulary. The A008 compiler flattens these into TaskSpecs; this object is the requirement source, not a compiled task.",
  "properties": {
    "allowedTools": {
      "items": {
        "$ref": "#/$defs/artifactRef"
      },
      "type": "array"
    },
    "constraints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "difficulty": {
      "enum": [
        "exploratory",
        "standard",
        "routine"
      ]
    },
    "evidenceCriteria": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "forbiddenShortcuts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "objectives": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "successConditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "objectives",
    "constraints",
    "allowedTools",
    "forbiddenShortcuts",
    "successConditions",
    "evidenceCriteria",
    "difficulty"
  ],
  "title": "Arena task requirements v1",
  "type": "object"
}

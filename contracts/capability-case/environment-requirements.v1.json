{
  "$defs": {
    "artifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9-]{1,127}$",
          "type": "string"
        },
        "namespace": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "version",
        "digest"
      ],
      "type": "object"
    }
  },
  "$id": "arena:schema/capability-case/environment-requirements@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a case requires of execution environments: content-addressed environment declarations (ENV1.0 references, owned by @arena/environment-protocol) plus explicit constraint statements.",
  "properties": {
    "constraints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "environments": {
      "items": {
        "$ref": "#/$defs/artifactRef"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "environments",
    "constraints"
  ],
  "title": "Arena environment requirements v1",
  "type": "object"
}

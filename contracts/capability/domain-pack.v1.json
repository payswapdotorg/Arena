  "$id": "arena:schema/capability/domain-pack@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A domain pack descriptor (id, version, target domain, declared extensions: skills / environments / evaluators, plus edges and provenance). Packs extend the graph APPEND-ONLY and can never supersede/rewrite nodes they do not own (CAPABILITY_GRAPH_PACK_OVERREACH) — new domains extend the Arena lifecycle, they do not fork it (architecture-lock rule 21; requirement R37). Environments are explicit versioned references owned by the environment protocol, never first-class graph nodes.",
  "properties": {
    "declaration": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/packEdgeDeclaration"
          },
          "type": "array"
        },
        "environments": {
          "items": {
            "$ref": "#/$defs/environmentExtension"
          },
          "type": "array"
        },
        "evaluators": {
          "items": {
            "$ref": "#/$defs/evaluatorDeclaration"
          },
          "type": "array"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/skillDeclaration"
          },
          "type": "array"
        }
      },
      "required": [
        "skills",
        "evaluators",
        "environments",
        "edges"
      ],
      "type": "object"
    },
    "packId": {
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "recordDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "recordDigest"
      ],
      "type": "object"
    },
    "targetDomain": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "const": "domain"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "type": "object"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    }
  },
  "required": [
    "packId",
    "version",
    "targetDomain",
    "declaration",
    "provenance"
  ],
  "title": "Arena DomainPack v1",
  "type": "object"
}

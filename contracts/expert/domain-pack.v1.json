{
  "$id": "arena:schema/expert/domain-pack@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A content-addressed domain pack descriptor (R37): ADDS domain competency types and typed metadata fields. Packs can never alter lifecycle semantics or inject authority/PII fields — both are machine-rejected.",
  "properties": {
    "competencyTypes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "pattern": "^[a-z][a-z0-9-]{0,63}(\\.[a-z][a-z0-9-]{0,63})*$",
            "type": "string"
          }
        },
        "required": [
          "type",
          "description"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "metadataFields": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "field": {
            "minLength": 1,
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "valueType": {
            "enum": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "required": [
          "field",
          "valueType",
          "required",
          "description"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "packVersion": {
      "const": 1
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    }
  },
  "required": [
    "packVersion",
    "id",
    "version",
    "description",
    "competencyTypes",
    "metadataFields",
    "digest"
  ],
  "title": "Arena expert domain pack v1",
  "type": "object"
}

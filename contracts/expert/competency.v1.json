{
  "$defs": {
    "capabilityNodeRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "domain",
            "capability",
            "sub-capability",
            "skill",
            "tool",
            "task-family",
            "evaluator",
            "verifier",
            "expert-competency",
            "observed-failure",
            "body-version"
          ]
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "evidenceRef": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "description"
      ],
      "type": "object"
    }
  },
  "$id": "arena:schema/expert/competency@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One expert competency: a capability/skill node ref, a typed proficiency level, >= 1 digest-addressed proficiency evidence refs (R7), and optional pack-declared domain extension data (R37).",
  "properties": {
    "capability": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "capability",
            "sub-capability",
            "skill",
            "expert-competency"
          ]
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "competencyVersion": {
      "const": 1
    },
    "domainMetadata": {
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "minProperties": 1,
      "type": "object"
    },
    "domainType": {
      "pattern": "^[a-z][a-z0-9-]{0,63}(\\.[a-z][a-z0-9-]{0,63})*$",
      "type": "string"
    },
    "proficiency": {
      "enum": [
        "introductory",
        "working",
        "proficient",
        "advanced",
        "distinguished"
      ]
    },
    "proficiencyEvidence": {
      "items": {
        "$ref": "#/$defs/evidenceRef"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "competencyVersion",
    "capability",
    "proficiency",
    "proficiencyEvidence"
  ],
  "title": "Arena expert competency v1",
  "type": "object"
}

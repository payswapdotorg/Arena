{
  "$id": "arena:schema/expert/credential-ref@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A professional credential reference (kind, opaque neutral reference, optional issuing body). Qualification DATA — never an authorization grant (lock rule 9).",
  "properties": {
    "issuer": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "professional-license",
        "certification",
        "degree",
        "training-certificate",
        "credential-attestation",
        "external-credential"
      ]
    },
    "reference": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "reference"
  ],
  "title": "Arena credential ref v1",
  "type": "object"
}

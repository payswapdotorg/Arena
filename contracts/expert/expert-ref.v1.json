{
  "$id": "arena:schema/expert/expert-ref@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A content-addressed reference to one exact expert-profile state: identity + version + the sha256 digest of that state canonical content.",
  "properties": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expertId": {
      "pattern": "^expert-[a-z0-9][a-z0-9-]{0,61}$",
      "type": "string"
    },
    "tenant": {
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    }
  },
  "required": [
    "tenant",
    "expertId",
    "version",
    "digest"
  ],
  "title": "Arena expert version ref v1",
  "type": "object"
}

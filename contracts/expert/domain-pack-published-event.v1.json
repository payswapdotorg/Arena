{
  "$defs": {
    "domainPack": {
      "additionalProperties": false,
      "properties": {
        "competencyTypes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "pattern": "^[a-z][a-z0-9-]{0,63}(\\.[a-z][a-z0-9-]{0,63})*$",
                "type": "string"
              }
            },
            "required": [
              "type",
              "description"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "metadataFields": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "minLength": 1,
                "type": "string"
              },
              "field": {
                "minLength": 1,
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "valueType": {
                "enum": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "field",
              "valueType",
              "required",
              "description"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "packVersion": {
          "const": 1
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "packVersion",
        "id",
        "version",
        "description",
        "competencyTypes",
        "metadataFields",
        "digest"
      ],
      "type": "object"
    },
    "principal": {
      "additionalProperties": false,
      "properties": {
        "principalId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "tenant": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "type": "string"
        },
        "type": {
          "enum": [
            "agent-body",
            "expert",
            "user",
            "service",
            "system"
          ]
        }
      },
      "required": [
        "type",
        "tenant",
        "principalId"
      ],
      "type": "object"
    }
  },
  "$id": "arena:schema/expert/domain-pack-published-event@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Event payload emitted when a domain pack descriptor is published: the content-addressed pack and the publishing principal.",
  "properties": {
    "pack": {
      "$ref": "#/$defs/domainPack"
    },
    "publishedBy": {
      "$ref": "#/$defs/principal"
    }
  },
  "required": [
    "pack",
    "publishedBy"
  ],
  "title": "Arena domain-pack-published event payload v1",
  "type": "object"
}

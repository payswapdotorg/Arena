{
  "$defs": {
    "bodyVersionRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9-]{1,127}$",
          "type": "string"
        },
        "tenant": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "tenant",
        "name",
        "version",
        "digest"
      ],
      "type": "object"
    }
  },
  "$id": "arena:schema/model-substrate/compatibility-test@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "SubstrateCompatibilityTest descriptor: binds a BodyVersion reference + a substrate reference (by content digest) + the profile requirements asserted (required modalities, minimum tool-calling level, minimum context units, prohibited substrate conditions). Pure data contract — the compatibility ENGINE is A022. No field may assert a substrate/model ≡ body identity alias (rejected at construction; spec AB1.0 hard rule).",
  "properties": {
    "bodyVersion": {
      "$ref": "#/$defs/bodyVersionRef"
    },
    "recordVersion": {
      "const": 1
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "minContextUnits": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "prohibitedConditions": {
          "items": {
            "enum": [
              "stable",
              "preview",
              "deprecated",
              "rate-limited",
              "region-restricted",
              "sovereign-only",
              "capacity-constrained"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "requiredModalities": {
          "items": {
            "enum": [
              "text-input",
              "text-output",
              "image-input",
              "image-output",
              "audio-input",
              "audio-output",
              "video-input",
              "structured-input",
              "structured-output"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "requiredToolCalling": {
          "enum": [
            "none",
            "text-protocol",
            "json-schema",
            "function-calling"
          ]
        }
      },
      "required": [
        "requiredModalities",
        "requiredToolCalling",
        "minContextUnits",
        "prohibitedConditions"
      ],
      "type": "object"
    },
    "substrateDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "testId": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "recordVersion",
    "testId",
    "bodyVersion",
    "substrateDigest",
    "spec"
  ],
  "title": "Arena substrate compatibility test v1",
  "type": "object"
}

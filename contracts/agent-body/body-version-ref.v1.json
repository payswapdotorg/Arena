{
  "$id": "arena:schema/agent-body/body-version-ref@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A content-addressed reference to an immutable BodyVersion: body identity, version and the sha256 content digest of the referenced version. The unit of lineage parents, supersession and the AgentBody version registry.",
  "properties": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9-]{1,127}$",
      "type": "string"
    },
    "tenant": {
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    }
  },
  "required": [
    "tenant",
    "name",
    "version",
    "digest"
  ],
  "title": "Arena BodyVersionRef v1",
  "type": "object"
}

{
  "$defs": {
    "cognitiveSubstrate": {
      "additionalProperties": false,
      "properties": {
        "adapterId": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "adapterVersion": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        },
        "conditions": {
          "items": {
            "enum": [
              "stable",
              "preview",
              "deprecated",
              "rate-limited",
              "region-restricted",
              "sovereign-only",
              "capacity-constrained"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "contextLimits": {
          "$ref": "#/$defs/contextLimits"
        },
        "integrity": {
          "additionalProperties": false,
          "properties": {
            "contentDigest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "digestAlgorithm": {
              "const": "sha256"
            }
          },
          "required": [
            "digestAlgorithm",
            "contentDigest"
          ],
          "type": "object"
        },
        "modalityProfile": {
          "items": {
            "enum": [
              "text-input",
              "text-output",
              "image-input",
              "image-output",
              "audio-input",
              "audio-output",
              "video-input",
              "structured-input",
              "structured-output"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "modelFamily": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "modelId": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "modelRevision": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "recordVersion": {
          "const": 1
        },
        "toolCallingProfile": {
          "enum": [
            "none",
            "text-protocol",
            "json-schema",
            "function-calling"
          ]
        }
      },
      "required": [
        "recordVersion",
        "adapterId",
        "adapterVersion",
        "modelFamily",
        "modelId",
        "modelRevision",
        "modalityProfile",
        "toolCallingProfile",
        "contextLimits",
        "conditions",
        "integrity"
      ],
      "type": "object"
    },
    "contextLimits": {
      "additionalProperties": false,
      "properties": {
        "maxContextUnits": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "maxOutputUnits": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "maxContextUnits",
        "maxOutputUnits"
      ],
      "type": "object"
    }
  },
  "$id": "arena:schema/agent-body/substrate-registered-event@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Event payload emitted when a cognitive substrate is registered. Travels inside Envelope<T> with a correlation id and canonical serialization.",
  "properties": {
    "substrate": {
      "$ref": "#/$defs/cognitiveSubstrate"
    }
  },
  "required": [
    "substrate"
  ],
  "title": "Arena substrate-registered event payload v1",
  "type": "object"
}

{
  "$id": "arena:schema/escalation/escalation-webhook-event@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The closed 13-event minimum vocabulary (ES1.0). Delivery is durable, at-least-once; eventId IS the idempotent consumer key and (requestId, sequence) is the ordering key. The webhook stream is a projection of the canonical lifecycle — never a second semantic authority.",
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "data": {
      "description": "Structured, kind-dependent plain-JSON data."
    },
    "eventId": {
      "pattern": "^evt_[0-9a-f]{32}$",
      "type": "string"
    },
    "eventType": {
      "enum": [
        "escalation.created",
        "escalation.matched",
        "escalation.accepted",
        "escalation.session.ready",
        "escalation.started",
        "escalation.progressed",
        "escalation.submitted",
        "escalation.validation.updated",
        "escalation.completed",
        "escalation.failed",
        "escalation.cancelled",
        "escalation.payment.updated",
        "escalation.learning.updated"
      ]
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "requestId": {
      "pattern": "^esc_[0-9a-f]{32}$",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "state": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "created",
            "triaged",
            "matching",
            "offered",
            "accepted",
            "session_ready",
            "in_progress",
            "submitted",
            "validating",
            "result_accepted",
            "revision_required",
            "result_rejected",
            "paid",
            "learning_captured",
            "expert_replaced",
            "closed",
            "cancelled",
            "timed_out"
          ]
        }
      ]
    },
    "tenantId": {
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "type": "string"
    }
  },
  "required": [
    "eventVersion",
    "eventId",
    "eventType",
    "requestId",
    "tenantId",
    "correlationId",
    "sequence",
    "occurredAt",
    "state",
    "data"
  ],
  "title": "Arena escalation webhook event v1",
  "type": "object"
}

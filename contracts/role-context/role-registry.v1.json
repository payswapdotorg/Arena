{
  "$defs": {
    "roleDefinition": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "primarySurfaces": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "recordVersion": {
          "const": 1
        },
        "roleId": {
          "enum": [
            "administrator",
            "agent-builder",
            "evaluator",
            "expert",
            "marketplace-participant",
            "operator",
            "owner",
            "researcher"
          ]
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "type": "string"
        }
      },
      "required": [
        "recordVersion",
        "roleId",
        "name",
        "goal",
        "primarySurfaces",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "arena:schema/role-context/role-registry@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The versioned, append-only-style registry of role definitions (8 RC1.0 reference roles at registryVersion 1.0.0). Consumers reject registries whose version they do not expect (REGISTRY_VERSION_MISMATCH).",
  "properties": {
    "recordVersion": {
      "const": 1
    },
    "registryVersion": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "type": "string"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/roleDefinition"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "recordVersion",
    "registryVersion",
    "roles"
  ],
  "title": "Arena role registry v1",
  "type": "object"
}

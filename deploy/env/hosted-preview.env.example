# Arena hosted preview — environment contract (Work Order B015).
#
# EMPTY placeholders by design: NEVER commit real credentials. Live values
# are injected server-side by the Tech Lead at the launch gate (B019); see
# deploy/env/hosted-preview.env.example consumers in ops/deployment/provider-setup.md.
#
# Source of truth: this file is the rendered artifact of
# deploy/src/hosted/env-contract.ts (HOSTED_ENV_VARS).
# Quota ceilings: docs/deployment/free-tier-architecture.md (fail-closed).

# --- Neon PostgreSQL (control-plane store) — B002 hosted adapter ---
# Neon PostgreSQL connection string (postgres:// or postgresql://); authoritative control-plane store.
DATABASE_URL=
# Alternative to DATABASE_URL for the Neon adapter (same scheme rules); DATABASE_URL wins when both are set.
NEON_CONNECTION_STRING=

# --- Cloudflare R2 (object store) — B002 hosted adapter ---
# Cloudflare R2 access key id (S3-compatible API token).
R2_ACCESS_KEY_ID=
# Cloudflare R2 secret access key.
R2_SECRET_ACCESS_KEY=
# Cloudflare R2 bucket name for trajectories, datasets, evidence bundles and releases.
R2_BUCKET=
# Explicit S3-compatible endpoint (https://<account-id>.r2.cloudflarestorage.com); takes precedence over R2_ACCOUNT_ID.
R2_S3_ENDPOINT=
# Cloudflare account id — the endpoint is derived when R2_S3_ENDPOINT is absent (one of the two is required).
R2_ACCOUNT_ID=

# --- Upstash Redis (coordination store) — B002 hosted adapter ---
# Upstash Redis REST endpoint (http/https) for bounded, rebuildable coordination state.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST bearer token.
UPSTASH_REDIS_REST_TOKEN=

# --- Apify (optional data acquisition) ---
# Optional Apify platform token; absent wiring stays disabled — Apify is never required for the primary lifecycle.
APIFY_TOKEN=

# --- Session boundary (B004 auth) ---
# Session signing secret (min 32 characters; shorter fails closed with AUTH_DISABLED — B004 session boundary).
ARENA_SESSION_SECRET=

# CI deploy credentials (VERCEL_TOKEN / VERCEL_ORG_ID / VERCEL_PROJECT_ID)
# are GitHub repository secrets — never runtime env; see
# ops/deployment/provider-setup.md (secret injection at the B019 gate).

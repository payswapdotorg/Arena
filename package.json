{
  "name": "arena",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "boundary": "node scripts/boundary-check.mjs",
    "build": "turbo run build",
    "check": "pnpm run check:governance && pnpm run check:boundary",
    "check:boundary": "node scripts/boundary-check.mjs",
    "check:governance": "python3 scripts/governance-check.py",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "governance": "python3 scripts/governance-check.py",
    "lint": "turbo run lint && eslint scripts eslint.config.mjs",
    "new-package": "node scripts/new-package.mjs",
    "product:doctor": "node scripts/product/doctor.mjs",
    "product:install": "node scripts/product/install.mjs",
    "product:reset": "node scripts/product/reset.mjs",
    "product:seed": "node scripts/product/seed.mjs",
    "test": "turbo run test",
    "test:product": "node scripts/product/tests/run-tests.mjs",
    "typecheck": "turbo run typecheck",
    "test:e2e": "node tests/product-e2e/run.mjs",
    "test:ux": "node tests/ux/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}

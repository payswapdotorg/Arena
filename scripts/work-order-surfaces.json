{
  "version": "1.0.0",
  "description": "Machine-readable work-order owned-surface registry. Derived from spec/work-items.md (AWO1.0 dispatch contract). The governance checker (scripts/governance-check.py) enforces: (1) every changed path in a work-order branch matches at least one surface of SOME work order; (2) concurrently ACTIVE/AUTHORIZED work orders have pairwise-disjoint surfaces.",
  "semantics": {
    "globs": "fnmatch-style. '*' matches any characters including '/'. A pattern without '*' is an exact path. A pattern ending in '/*' covers the directory tree beneath the prefix.",
    "root_manifests": "A001's 'root manifests' surface from spec/work-items.md, expanded to explicit root-level file paths.",
    "active_statuses": ["ACTIVE", "AUTHORIZED"],
    "notes": "AUTHORIZED is the dispatch status used by spec/PROJECT-STATE.md while a Work Order is in flight; ACTIVE is the docs/GOVERNANCE.md lifecycle term. Both count as concurrent-active for overlap checks."
  },
  "carve_outs": [
    {
      "work_order": "A001",
      "paths": ["docs/repo-layout.md", "docs/verification-baseline.md"],
      "reason": "Dispatched A001 acceptance criteria item 10 explicitly requires these two files, although spec/work-items.md A001 surfaces do not include docs/*. Recorded here transparently so the ownership check remains machine-auditable; flagged to the Tech Lead as an architecture question in the A001 final report."
    }
  ],
  "work_orders": {
    "A001": {
      "surfaces": [
        "package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "eslint.config.mjs",
        ".eslintrc*",
        ".prettierrc*",
        ".prettierignore",
        ".gitignore",
        ".npmrc",
        ".nvmrc",
        ".editorconfig",
        "LICENSE",
        "apps/*",
        "packages/protocol-core/*",
        "scripts/*",
        ".github/*"
      ]
    },
    "A002": { "surfaces": ["packages/artifact-protocol/*", "packages/provenance/*", "contracts/artifacts/*"] },
    "A003": { "surfaces": ["packages/agent-body/*", "contracts/agent-body/*"] },
    "A004": { "surfaces": ["packages/capability-graph/*", "contracts/capability/*"] },

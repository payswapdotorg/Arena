{
  "version": "1.0.0",
  "description": "Machine-readable work-order owned-surface registry. Derived from spec/work-items.md (A-series, AWO1.0), spec/post-v1-work-items.md (B-series, BWO1.0), spec/human-escalation-work-items.md (C-series, CWO roster) and spec/post-b019-launch-integrity-closure.md (G-series). The governance checker (scripts/governance-check.py) enforces: (1) every changed path in a work-order branch matches at least one surface of SOME work order; (2) concurrently ACTIVE/AUTHORIZED work orders have pairwise-disjoint surfaces. P-series productionization WOs are defined in spec/post-roadmap-production-work-items.md.",
  "semantics": {
    "globs": "fnmatch-style. '*' matches any characters including '/'. A pattern without '*' is an exact path. A pattern ending in '/*' covers the directory tree beneath the prefix.",
    "root_manifests": "A001's 'root manifests' surface from spec/work-items.md, expanded to explicit root-level file paths.",
    "active_statuses": [
      "ACTIVE",
      "AUTHORIZED"
    ],
    "notes": "AUTHORIZED is the dispatch status used by spec/PROJECT-STATE.md while a Work Order is in flight; ACTIVE is the docs/GOVERNANCE.md lifecycle term. Both count as concurrent-active for overlap checks."
  },
  "carve_outs": [
    {
      "work_order": "A001",
      "paths": [
        "docs/repo-layout.md",
        "docs/verification-baseline.md"
      ],
      "reason": "Dispatched A001 acceptance criteria item 10 explicitly requires these two files, although spec/work-items.md A001 surfaces do not include docs/*. Recorded here transparently so the ownership check remains machine-auditable; flagged to the Tech Lead as an architecture question in the A001 final report."
    }
  ],

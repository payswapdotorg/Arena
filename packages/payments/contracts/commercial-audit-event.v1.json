{
  "$id": "arena:schema/payments/commercial-audit-event@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One audit event per APPLIED money operation (the commercial audit surface). Duplicates append nothing — they replay the recorded event verbatim.",
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "eventId": {
      "pattern": "^cevt_[0-9a-f]{32}$",
      "type": "string"
    },
    "eventVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "payment.hold.recorded",
        "payment.offer.recorded",
        "payment.acceptance.recorded",
        "payment.capture.recorded",
        "payment.release.recorded",
        "payment.refund.recorded"
      ]
    },
    "ledgerStateAfter": {
      "enum": [
        "opened",
        "held",
        "offered",
        "accepted",
        "captured",
        "released",
        "refunded"
      ]
    },
    "occurredAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "operationKey": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "summary": {
      "description": "Machine-readable account deltas + amounts (plain JSON).",
      "type": "object"
    },
    "tenantId": {
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "type": "string"
    },
    "truth": {
      "enum": [
        "demo",
        "customer"
      ]
    }
  },
  "required": [
    "eventVersion",
    "eventId",
    "kind",
    "requestId",
    "tenantId",
    "correlationId",
    "operationKey",
    "sequence",
    "occurredAt",
    "ledgerStateAfter",
    "truth",
    "summary"
  ],
  "title": "Arena commercial audit event v1",
  "type": "object",
  "x-transfer-destinations": [
    "platform",
    "expert"
  ]
}

{
  "name": "@arena/ui-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./tokens.css": "./src/tokens/tokens.css",
    "./components.css": "./src/styles/components.css"
  },
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./tokens.css": "./dist/tokens.css",
      "./components.css": "./dist/components.css"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && cp src/tokens/tokens.css dist/tokens.css && cp src/styles/components.css dist/components.css",
    "tokens:css": "node --experimental-strip-types scripts/write-tokens-css.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
